# Copy to .env.oracle on the Oracle host. Do not commit the copy.
# Generate a new API token there: openssl rand -hex 32

AISTUDIO_API_KEY=replace-with-a-long-random-token-at-least-32-chars

# Manifest-list digest from the merge job. Do not deploy floating :latest.
AISTUDIO_IMAGE=ghcr.io/dreamdana88/aistudio-api@sha256:REPLACE_WITH_MULTIARCH_MANIFEST_DIGEST

# Site root only. The app appends /vnc.html?autoconnect=1&resize=scale.
AISTUDIO_NOVNC_PUBLIC_URL=https://LOGIN_DOMAIN:8443

# Host loopback ports. 18080 is the tavern; leave it alone.
AISTUDIO_BIND_PORT=18081
AISTUDIO_NOVNC_BIND_PORT=6080

# Leave empty. Do not copy the old machine's private proxy.
AISTUDIO_PROXY=
AISTUDIO_REDUCED_MOTION=1
